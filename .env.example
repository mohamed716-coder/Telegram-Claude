# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather (this is YOUR bot, the one people talk to)
BOT_TOKEN=123456789:AAAA...

# Leave empty: login.py saves your account's login in the data folder.
# (Only fill this in on hosts without a data folder: python login.py --print)
SESSION_STRING=

# Optional settings
# The bot your account sends messages to
TARGET_BOT=@KageNoKoroshiBot
# Commands that are passed through to the target bot as typed
COMMANDS=kd,zz,ko
# Your own account is always admin. Extra admins (comma-separated Telegram user IDs):
ADMIN_IDS=
# Start of every generated code, e.g. ANONYMOUS-81ja5j9H5R4
CODE_PREFIX=ANONYMOUS
# Max seconds to wait for the target bot's answer
REPLY_TIMEOUT=30
# Answer is complete once the target bot is quiet this many seconds
SETTLE_SECONDS=3
# After answering, keep watching this many seconds for the target bot to edit its
# answer, and update the user's message too (0 = off). Requests from other users wait
# in the queue meanwhile, so answers can never be mixed up between users.
EDIT_WAIT=20
# Where the bot keeps its login and the codes/users database (Docker sets this for you)
# DATA_DIR=data
