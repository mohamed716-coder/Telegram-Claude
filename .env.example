# Copy this file to .env and fill in BOT_TOKEN.

# Required: the token @BotFather gave you
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Optional (these are the defaults)
OWNER_ID=6883493877
BINANCE_PAY_ID=850940840
DB_PATH=data/shop.db
SELLER_DISCOUNT_PERCENT=10
SELLER_AUTO_THRESHOLD=1000

# Automatic deposits (optional): a read-only Binance API key of the account with
# BINANCE_PAY_ID, with only "Enable Reading" on (DEPLOY.md, "Automatic deposits with
# Binance Pay"). Customers then send the Order ID of their payment and it's added at once
# when the amount matches. Without a key, the owner checks a receipt for each deposit.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# The coins added 1:1 in $ (comma-separated), and how many hours back payments are found.
BINANCE_COINS=USDT
BINANCE_MAX_AGE_HOURS=48

# Who customers are told to contact (shown in /help and when a deposit is rejected).
# Empty = the owner's @username. Use e.g. @my_support or a link, or "none" to hide it.
SUPPORT_CONTACT=
