# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather (this is YOUR bot, the one people talk to)
BOT_TOKEN=123456789:AAAA...

# Printed by `python login.py` (this is YOUR ACCOUNT - keep it secret!)
SESSION_STRING=

# The bot your account sends messages to
TARGET_BOT=@target_bot

# The message your account sends. {arg} is replaced by what the user typed after /kd
MESSAGE_TEMPLATE=/kd {arg}

# Optional settings
# Which values are accepted after /kd (regular expression)
ARG_PATTERN=[A-Za-z0-9_.-]{1,64}
# Comma-separated Telegram user IDs allowed to use the bot; empty = everyone
ALLOWED_USERS=
# Seconds each user must wait between requests
COOLDOWN_SECONDS=20
# Max seconds to wait for the target bot's answer
REPLY_TIMEOUT=30
# Answer is complete once the target bot is quiet this many seconds
SETTLE_SECONDS=3
